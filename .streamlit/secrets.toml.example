# ---------------------------------------------------------------------------
# Copy this file to `secrets.toml` (same folder) and fill in real values to
# enable Google / Apple sign-in via Streamlit's native OpenID Connect support.
# Leave it absent to use the built-in demo email sign-in.
# Docs: https://docs.streamlit.io/develop/concepts/connections/authentication
# ---------------------------------------------------------------------------

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "change-me-to-a-long-random-string"

# --- Google ---
[auth.google]
client_id = "YOUR_GOOGLE_CLIENT_ID"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# --- Apple ---
# Apple's OIDC requires a generated client_secret JWT. See README for steps.
[auth.apple]
client_id = "YOUR_APPLE_SERVICE_ID"
client_secret = "YOUR_APPLE_CLIENT_SECRET_JWT"
server_metadata_url = "https://appleid.apple.com/.well-known/openid-configuration"
